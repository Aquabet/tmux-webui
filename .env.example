# 复制为 .env 并填写（.env 已被 .gitignore 排除，不会提交）
# 值可以用单引号包裹；不支持变量展开（$ 原样保留，bcrypt 哈希安全）

# 必填：`tmux-webui init` 会写进 ~/.tmux-webui/config.json；
# 想放在项目里就用 `npm run hash-password -- <密码>` 生成后粘贴到这里
TMUX_WEBUI_PASSWORD_HASH=''

# 以下均可选（注释掉即用默认值）
# TMUX_WEBUI_HOST=127.0.0.1
# TMUX_WEBUI_PORT=8090
# TMUX_WEBUI_SOCKET=
# TMUX_WEBUI_SESSION_TTL_MS=604800000
# TMUX_WEBUI_COOKIE_SECURE=false
# TMUX_WEBUI_UPDATE_CHECK=true
# TMUX_WEBUI_USAGE_PROVIDERS=codex,claude
# TMUX_WEBUI_UPLOAD_DIR=/absolute/path/to/uploads
# TMUX_WEBUI_UPLOAD_RETENTION_MS=604800000
# TMUX_WEBUI_UPLOAD_MAX_BYTES=536870912
