{
  "name": "tmux-webui",
  "version": "3.1.9",
  "description": "tmux in your browser: session sidebar, window tabs, fully interactive terminal, mobile-friendly",
  "keywords": [
    "tmux",
    "terminal",
    "web-terminal",
    "xterm",
    "ssh-alternative",
    "mobile"
  ],
  "license": "MIT",
  "author": "Aquabet",
  "homepage": "https://github.com/Aquabet/tmux-webui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aquabet/tmux-webui.git"
  },
  "bugs": {
    "url": "https://github.com/Aquabet/tmux-webui/issues"
  },
  "type": "module",
  "bin": {
    "tmux-webui": "dist/main.js"
  },
  "files": [
    "dist",
    "web/dist",
    "scripts/agent-status-hook.sh",
    "scripts/install-agent-status.mjs",
    "integrations",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "vite": "6.4.3",
    "postcss": "8.5.26",
    "nanoid": "3.3.18"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:deadcode": "knip",
    "check:shell": "shellcheck scripts/*.sh e2e/*.sh",
    "hash-password": "tsx scripts/hash-password.ts",
    "test:e2e": "bash e2e/setup-tmux.sh && playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.22.2",
    "node-pty": "^1.0.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^5.88.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
