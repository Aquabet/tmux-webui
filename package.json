{
  "name": "tmux-webui",
  "version": "3.1.0",
  "description": "tmux in your browser: session sidebar, window tabs, fully interactive terminal, mobile-friendly",
  "keywords": [
    "tmux",
    "terminal",
    "web-terminal",
    "xterm",
    "ssh-alternative",
    "mobile"
  ],
  "license": "MIT",
  "author": "Aquabet",
  "homepage": "https://github.com/Aquabet/tmux-webui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aquabet/tmux-webui.git"
  },
  "bugs": {
    "url": "https://github.com/Aquabet/tmux-webui/issues"
  },
  "type": "module",
  "bin": {
    "tmux-webui": "dist/main.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && npm --prefix web run build",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "hash-password": "tsx scripts/hash-password.ts",
    "test:e2e": "bash e2e/setup-tmux.sh && playwright test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
